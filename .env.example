# BNP Care AI Manager — environment configuration
#
# Copy to .env and fill in. Never commit .env.
# A JWT signing secret was previously committed in .replit; treat that value as
# compromised and generate fresh secrets below.

# ── Database (required) ───────────────────────────────────────────────────────
# The clinical engine refuses to start without this: it cannot record an audit
# trail, and it must not answer clinical questions unaudited.
DATABASE_URL=postgresql://bnp:bnp@localhost:5432/bnp

# Connection pool bounds for the engine.
DB_POOL_MIN=1
DB_POOL_MAX=10

# 1 (default): the engine applies pending migrations on startup — correct for a
# single instance. 0: a dedicated migration job runs first and the engine
# refuses to start against an unmigrated database. Docker uses 0.
AUTO_MIGRATE=1

# ── Secrets (required) ────────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32
#
# JWT_SECRET signs the engine's own tokens. There is no default — the engine
# fails to start rather than run on a publicly known key.
JWT_SECRET=

# ENGINE_JWT_SECRET is used by the API server to mint per-user engine tokens.
# It MUST equal the engine's JWT_SECRET, or the gateway's tokens are rejected.
ENGINE_JWT_SECRET=

# ── Clinical AI (required for the engine to serve queries) ────────────────────
# Without this the engine reports 503 degraded and refuses to answer. It does
# not fall back to synthetic embeddings — a plausible ungrounded answer is the
# dangerous failure mode.
OPENAI_API_KEY=

# Optional: route GPT-4o through Replit's AI Integration proxy instead of calling
# OpenAI directly. Both must be set for the proxy to be used; otherwise the
# engine falls back to OPENAI_API_KEY above, and then to returning the retrieved
# source text with no generated answer at all. Read at
# services/response_generator.py:180. Leave empty outside Replit.
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=

# ── Authorization ─────────────────────────────────────────────────────────────
# Comma-separated emails granted the admin role on sign-in. Admins can read the
# audit log, upload or delete corpus documents, and import and approve formulary
# entries — approving a drug is what allows the system to quote a dose for it.
# Roles are never taken from client input or OIDC claims.
ADMIN_EMAILS=

# ── First sign-in account ─────────────────────────────────────────────────────
# A fresh database has no users, and off Replit there is no OIDC issuer to
# create one — so without these a correctly deployed stack has no way in.
#
# Set both on the first boot, then clear them. They are never used to update an
# existing account: leaving them set would otherwise reset the password on every
# restart, and anyone who could read the deploy config would own the account.
#
# The password must be at least 12 characters and not contain a well-known
# guessable string. A rejected password stops the server from starting rather
# than being accepted with a warning.
#
# Admin rights come from ADMIN_EMAILS, not from this being the bootstrap
# account. If the address below is not listed there, this creates a plain user.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ── Service wiring ────────────────────────────────────────────────────────────
# Where the API server reaches the clinical engine. The engine should not be
# published to the public internet; all traffic goes through /bnp-api.
ENGINE_URL=http://127.0.0.1:8000

# Browser origins allowed to call the engine directly. Normally empty: the
# gateway is same-origin. A wildcard is never accepted.
CORS_ORIGINS=

# API server listen port.
PORT=8080

# Engine log format: "json" for shippable structured logs, "text" for local dev.
LOG_FORMAT=text

# Where the API server finds the built web app, so it can serve the SPA from the
# same origin as /api and /bnp-api. Relative to the process working directory.
# A deployment that gives one public URL per service needs this; under docker
# compose nginx fronts the SPA and the directory is simply never consulted.
# Unset it, or point it at a directory with no index.html, and the API server
# serves only the API.
WEB_ROOT=public

# ── OIDC (required for login) ─────────────────────────────────────────────────
ISSUER_URL=https://replit.com/oidc
REPL_ID=

# ── Web app (build/dev only) ──────────────────────────────────────────────────
# Base path the SPA is served from.
BASE_PATH=/
# Dev-server proxy target for /api and /bnp-api.
API_SERVER_URL=http://localhost:8080

# Mobile interface language follows the device, defaulting to Arabic.
# ── Mobile app (build time) ───────────────────────────────────────────────────
# Host the mobile bundle calls. Without it the build falls back to localhost and
# the bundle cannot reach a real backend.
EXPO_PUBLIC_DOMAIN=
EXPO_PUBLIC_REPL_ID=
EXPO_PUBLIC_ISSUER_URL=https://replit.com/oidc
