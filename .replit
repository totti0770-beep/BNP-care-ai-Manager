modules = ["nodejs-24", "javascript", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/bestnursingai"

[[artifacts]]
id = "artifacts/clinical-ai-engine"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/clinical-ai-engine: Clinical AI Engine"

[[workflows.workflow]]
name = "artifacts/clinical-ai-engine: Clinical AI Engine"
author = "agent"

[[workflows.workflow.tasks]]
# Bound to loopback: the engine is reached through the API server's /bnp-api
# gateway, never directly from a browser.
task = "shell.exec"
args = "cd artifacts/clinical-ai-engine && uvicorn main:app --host 127.0.0.1 --port 8000 --reload --log-level info"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["cargo", "freetype", "glibcLocales", "gumbo", "harfbuzz", "jbig2dec", "libiconv", "libjpeg_turbo", "mupdf", "openjpeg", "rustc", "swig", "xcbuild"]

[userenv]

# Secrets are NOT stored here — this file is tracked in git. Set JWT_SECRET,
# ENGINE_JWT_SECRET, DATABASE_URL, OPENAI_API_KEY and ADMIN_EMAILS in Replit
# Secrets (or a local .env). See .env.example.
[userenv.shared]

[[ports]]
localPort = 8000
